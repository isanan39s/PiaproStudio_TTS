package main

import (
	"bytes"
	"fmt"
	"os"
)

func main() {
	templatePath := "raw_state_009c3-b3ドレミファソラシ.bin"
	data, err := os.ReadFile(templatePath)
	if err != nil {
		fmt.Println("Error:", err)
		return
	}

	// EVTS パッチ: Pitch は 0x08 から 7バイト目
	evtsIdx := bytes.Index(data, []byte("EVTS"))
	if evtsIdx != -1 {
		curr := evtsIdx + 8
		for i := 0; i < 3; i++ {
			found := bytes.Index(data[curr:], []byte{0x08})
			if found == -1 { break }
			pos := curr + found
			// pos + 0: 08
			// pos + 1,2: size
			// pos + 3,4,5,6: tick
			// pos + 7: pitch
			data[pos+7] = 72 
			curr = pos + 20
		}
	}

	// ENOT パッチ: Pitch は ENOT から 14バイト目
	curr := 0
	for i := 0; i < 3; i++ {
		found := bytes.Index(data[curr:], []byte("ENOT"))
		if found == -1 { break }
		pos := curr + found
		data[pos+14] = 72
		curr = pos + 20
	}

	os.WriteFile("test_correct_pitch.bin", data, 0644)
	fmt.Println("Successfully generated test_correct_pitch.bin")
}
